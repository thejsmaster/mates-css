{
  "name": "mates-css",
  "version": "0.5.0",
  "description": "CSS library for all frameworks like React, Vue, Mates, Angular, Solid, Svelte, Lit. Even plain JS. It even comes with a design system. A compact pure-CSS no-JS library with design tokens, automatic dark mode, flex & grid utilities, and CSS-only charts.",
  "style": "mates.min.css",
  "main": "mates.min.css",
  "unpkg": "mates.min.css",
  "jsdelivr": "mates.min.css",
  "files": [
    "mates.css",
    "mates.min.css",
    "src",
    "docs.html",
    "demo.html",
    "playground.html",
    "playground-preview.html",
    "llms.txt",
    "AGENTS.md",
    ".cursor/skills/mates-css",
    "LICENSE"
  ],
  "keywords": [
    "css",
    "css classes", 
    "css design tokens",
    "no js css",
    "ui-kit",
    "ui-library",
    "ui-framework",
    "react ui library",
    "vue ui library",
    "angular ui library",
    "solid ui library",
    "svelte ui library",
    "lit ui library",
    "plain js ui library",
    "ui library",
    "ui framework",
    "grid",
    "css utilities",
    "no-js css",
    "micro-framework",
    "llms.txt",
    "ai"
  ],
  "homepage": "https://github.com/thejsmaster/mates-css#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thejsmaster/mates-css.git"
  },
  "bugs": {
    "url": "https://github.com/thejsmaster/mates-css/issues"
  },
  "license": "MIT",
  "browserslist": [
    "chrome >= 94",
    "firefox >= 92",
    "safari >= 15"
  ],
  "author": "Sean Freeman",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "style": "./mates.min.css",
      "default": "./mates.min.css"
    },
    "./css": "./mates.css",
    "./min": "./mates.min.css",
    "./mates.css": "./mates.css",
    "./mates.min.css": "./mates.min.css",
    "./style.css": "./mates.css",
    "./llms": "./llms.txt",
    "./llms.txt": "./llms.txt",
    "./AGENTS.md": "./AGENTS.md",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "esbuild src/index.css --bundle --minify --outfile=mates.min.css --watch"
  }
}
