{
  "name": "mates-css",
  "version": "0.5.0",
  "description": "A compact pure-CSS no JS library. Design tokens, blue primary with hover/active ramps, automatic dark mode, flex & grid utilities and CSS-only charts. No JS.",
  "style": "mates.min.css",
  "main": "mates.min.css",
  "unpkg": "mates.min.css",
  "jsdelivr": "mates.min.css",
  "files": [
    "mates.css",
    "mates.min.css",
    "src",
    "demo.html"
  ],
  "keywords": [
    "css",
    "ui-kit",
    "components",
    "buttons",
    "cards",
    "modals",
    "charts",
    "dark-mode",
    "css-variables",
    "design-tokens",
    "flexbox",
    "grid",
    "utilities",
    "no-js",
    "micro-framework"
  ],
  "homepage": "https://github.com/thejsmaster/mates-css#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thejsmaster/mates-css.git"
  },
  "bugs": {
    "url": "https://github.com/thejsmaster/mates-css/issues"
  },
  "license": "MIT",
  "author": "your-name",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "style": "./mates.min.css",
      "default": "./mates.min.css"
    },
    "./css": "./mates.css",
    "./min": "./mates.min.css",
    "./mates.css": "./mates.css",
    "./mates.min.css": "./mates.min.css",
    "./style.css": "./mates.css",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "esbuild src/index.css --bundle --minify --outfile=mates.min.css --watch"
  }
}
