{
  "name": "mates-css",
  "version": "0.3.0",
  "description": "A compact pure-CSS UI kit. Design tokens, blue primary with hover/active ramps, automatic dark mode and flex & grid utilities. No JS.",
  "style": "mates.css",
  "main": "mates.min.css",
  "files": [
    "mates.css",
    "mates.min.css",
    "demo.html"
  ],
  "keywords": [
    "css",
    "ui-kit",
    "components",
    "buttons",
    "cards",
    "modals",
    "dark-mode",
    "css-variables",
    "design-tokens",
    "flexbox",
    "grid",
    "utilities",
    "no-js",
    "micro-framework"
  ],
  "homepage": "https://github.com/thejsmaster/mates-css#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thejsmaster/mates-css.git"
  },
  "bugs": {
    "url": "https://github.com/thejsmaster/mates-css/issues"
  },
  "license": "MIT",
  "author": "your-name",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "style": "./mates.css",
      "default": "./mates.min.css"
    },
    "./min": "./mates.min.css",
    "./mates.css": "./mates.css",
    "./style.css": "./mates.css",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "esbuild mates.css --minify --outfile=mates.min.css",
    "watch": "esbuild mates.css --minify --outfile=mates.min.css --watch"
  }
}
